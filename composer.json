{
  "name": "codwelt/toolsbox-registros",
  "description": "Formularios dinámicos de inscripción y exportación a Excel para WordPress.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^3.0",
    "wp-coding-standards/wpcs": "^3.3",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "autoload-dev": {
    "psr-4": {
      "Codwelt\\ToolsBoxRegistros\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.0.30"
    },
    "sort-packages": true
  },
  "scripts": {
    "lint": "phpcs",
    "test": "phpunit"
  }
}
