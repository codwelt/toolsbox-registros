<?xml version="1.0"?>
<ruleset name="ToolsBox Registros">
    <description>WordPress Coding Standards y compatibilidad con PHP 8.0.</description>
    <file>toolsbox-registros.php</file>
    <file>src</file>
    <file>templates</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <arg name="extensions" value="php"/>
    <arg value="sp"/>
    <config name="testVersion" value="8.0-"/>
    <rule ref="WordPress">
        <!-- Los nombres de archivo respetan el autoloader PSR-4 del plan. -->
        <exclude name="WordPress.Files.FileName"/>
    </rule>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="toolsbox-registros"/>
            </property>
        </properties>
    </rule>
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="tbreg"/>
                <element value="TBREG"/>
                <element value="Codwelt"/>
            </property>
        </properties>
    </rule>
    <rule ref="PHPCompatibilityWP"/>
    <rule ref="WordPress.WP.Capabilities">
        <properties>
            <property name="custom_capabilities" type="array">
                <element value="tbreg_manage_forms"/>
                <element value="tbreg_view_entries"/>
                <element value="tbreg_edit_entries"/>
                <element value="tbreg_export_entries"/>
            </property>
        </properties>
    </rule>
    <!-- La API de entidades/repositorios usa los nombres camelCase fijados en PLAN.md. -->
    <rule ref="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid">
        <exclude-pattern>*/src/Domain/*</exclude-pattern>
        <exclude-pattern>*/src/Repository/*</exclude-pattern>
    </rule>
    <!-- Las excepciones de dominio se convierten en WP_Error; se escapan al renderizar. -->
    <rule ref="WordPress.Security.EscapeOutput.ExceptionNotEscaped">
        <exclude-pattern>*/src/Domain/*</exclude-pattern>
        <exclude-pattern>*/src/Repository/*</exclude-pattern>
    </rule>
</ruleset>
